{
    "id": "/work",
    "name": "MoxDOP",
    "short_name": "MoxDOP",
    "description": "Moximu ajans operasyon paneli",
    "start_url": "/work",
    "scope": "/",
    "display": "standalone",
    "background_color": "#f5f4f0",
    "theme_color": "#fdcf3c",
    "lang": "tr",
    "shortcuts": [
        { "name": "Hızlı not", "short_name": "Not", "description": "Yapılacak ya da not ekle", "url": "/takvim?hizli=1", "icons": [{ "src": "/images/app/icon-192.png?v=2", "sizes": "192x192", "type": "image/png" }] },
        { "name": "Takvim", "url": "/takvim", "icons": [{ "src": "/images/app/icon-192.png?v=2", "sizes": "192x192", "type": "image/png" }] }
    ],
    "share_target": {
        "action": "/paylas",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [{ "name": "files", "accept": ["text/plain", "application/zip", ".txt", ".zip"] }]
        }
    },
    "icons": [
        { "src": "/images/app/icon-192.png?v=2", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/images/app/icon-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/images/app/icon-maskable-192.png?v=2", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
        { "src": "/images/app/icon-maskable-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
        { "src": "/images/app/badge-96.png?v=2", "sizes": "96x96", "type": "image/png", "purpose": "monochrome" }
    ]
}
