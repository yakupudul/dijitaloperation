APP_NAME=MoxDOP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production relational target for the normalized data pool is PostgreSQL (Prompt 10).
# Local/tests may use SQLite (phpunit.xml). MySQL remains supported for legacy app tables.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moxdop
DB_USERNAME=moxdop
DB_PASSWORD=

# Optional dedicated PostgreSQL connection for warehouse verification:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=moxdop
# DB_USERNAME=moxdop
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Optional Reverb (near-live invalidation). Collection correctness does NOT require Reverb.
# Polling fallback in Integrations monitoring remains available when WebSockets are down.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Collection engine (Prompt 9): production ingestion uses Redis + Horizon.
# Activity Center async may keep QUEUE_CONNECTION=database.
# Tests use Queue::fake() and do not require a live Redis server.
COLLECTION_QUEUE_CONNECTION=redis
COLLECTION_QUEUE=collection
COLLECTION_REQUIRE_QUEUE=true
COLLECTION_DEFAULT_MAX_ATTEMPTS=3
COLLECTION_JOB_TIMEOUT=300

# Data pool / raw ingestion (Prompt 10) — private object storage; no public ACL.
MOXDOP_RAW_INGESTION_DISK=raw_ingestion
MOXDOP_RAW_INGESTION_DRIVER=local
# MOXDOP_RAW_INGESTION_ROOT=  # defaults to storage/app/raw_ingestion
MOXDOP_RAW_COMPRESSION=gzip
MOXDOP_WAREHOUSE_BATCH_SIZE=500
# S3-compatible production raw disk (when MOXDOP_RAW_INGESTION_DRIVER=s3):
# MOXDOP_RAW_INGESTION_KEY=
# MOXDOP_RAW_INGESTION_SECRET=
# MOXDOP_RAW_INGESTION_REGION=
# MOXDOP_RAW_INGESTION_BUCKET=
# MOXDOP_RAW_INGESTION_ENDPOINT=
# MOXDOP_RAW_INGESTION_PATH_STYLE=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Agency Google Integration OAuth (application config — not tenant tokens). Never commit real secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; default is APP_URL + /integrations/google/callback
GOOGLE_REDIRECT_URI=
# Google Ads API application developer token (NOT an OAuth access/refresh token)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_OAUTH_STATE_TTL_MINUTES=15
GOOGLE_ACCESS_TOKEN_REFRESH_SKEW_SECONDS=60
GOOGLE_OAUTH_REFRESH_LOCK_SECONDS=20
# GBP requires business.manage scope + Google Business Profile API access approval.
GOOGLE_INCLUDE_GBP_SCOPE=false
GOOGLE_GBP_DISCOVERY_ENABLED=false

# Agency Meta Integration (application config — not tenant tokens). Never commit real secrets.
META_APP_ID=
META_APP_SECRET=
# Optional override; default is APP_URL + /integrations/meta/callback
META_REDIRECT_URI=
# Facebook Login for Business configuration ID (Meta App Dashboard)
META_LOGIN_CONFIGURATION_ID=
META_API_VERSION=v26.0
META_OAUTH_STATE_TTL_MINUTES=15
META_TOKEN_VALIDATION_TTL_SECONDS=900
META_USE_APPSECRET_PROOF=true
# Legacy bootstrap only — production path is Connect Meta OAuth
META_ACCESS_TOKEN=
META_TIMEOUT=20
META_MAX_PAGINATION_PAGES=20

# Encryption key rotation (Laravel) — comma-separated previous APP_KEY values during migration.
# Never commit real keys. Never pass keys as CLI arguments.
# APP_PREVIOUS_KEYS=

# AI provider secrets (deployment / Integration DB encrypted payload). Placeholders only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# DataForSEO (deployment bootstrap or Integration encrypted payload). Placeholders only.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Prompt 64 security hardening toggles
MOXDOP_SECURITY_HARDENING_ENABLED=true
# Do not enable share pepper without dual-read migration of existing hashes.
MOXDOP_SHARE_SECRET_PEPPER_ENABLED=false

# Prompt 66 observability — placeholders only; no fake quotas / health scores
MOXDOP_OBSERVABILITY_ENABLED=true
MOXDOP_OPS_WORKER_HEARTBEAT_STALE_SECONDS=180
# Comma-separated expected Horizon supervisor names for THIS deployment (empty = UNKNOWN capacity)
MOXDOP_OPS_EXPECTED_SUPERVISORS=
MOXDOP_OPS_QUEUE_INTERACTIVE_AGE_SECONDS=300
MOXDOP_OPS_ALERT_NOTIFY_ON_OPEN=true
MOXDOP_OPS_ALERT_NOTIFY_ON_RESOLVE=false
# Optional explicit recipient user IDs; empty = Admin role users; zero recipients = no notify-all
MOXDOP_OPS_ALERT_RECIPIENT_USER_IDS=
