{
    "manifest_version": 3,
    "name": "MoxDOP hızlı not",
    "version": "1.0.0",
    "description": "Hangi sayfada olursan ol: + ikonuna bas ya da Alt+N, yaz, Enter. Yapılacaklar ve notlar MoxDOP Takvim'e düşer.",
    "action": {
        "default_popup": "popup.html",
        "default_title": "MoxDOP: hızlı not (Alt+N)",
        "default_icon": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" }
    },
    "icons": { "16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png" },
    "permissions": ["activeTab"],
    "host_permissions": ["__HOST__"],
    "commands": {
        "_execute_action": {
            "suggested_key": { "default": "Alt+N", "mac": "Alt+N" },
            "description": "Hızlı not kutusunu aç"
        }
    }
}
