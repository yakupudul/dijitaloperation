  "formula_contract": {
    "registry_id": "MOXDOP_FORMULA_REGISTRY",
    "required_fields": [
      "id",
      "formula_version",
      "inputs",
      "output_type",
      "missing_policy",
      "provenance",
      "status"
    ],
    "abstain_when": [
      "required_capability_missing",
      "required_metric_missing",
      "identity_unresolved",
      "period_not_comparable",
      "currency_not_comparable",
      "coverage_insufficient",
      "provenance_incompatible"
    ],
    "output_flow": "Formula result -> canonical Evidence candidate -> existing CanonicalEvidencePipeline"
  },
  "rule_contract": {
    "registry_id": "MOXDOP_FINDING_RULES",
    "required_fields": [
      "stable_id",
      "version",
      "evidence_definition_ids",
      "activation",
      "clear",
      "fingerprint_inputs"
    ],
    "input_flow": "Eligible canonical Evidence only",
    "output_flow": "Existing Finding -> Recommendation -> manual Task",
    "ai_finding_creation": false
  }
}
