{
  "metadata": {
    "registry_id": "MOXDOP_INTELLIGENCE_CORE",
    "version": 1,
    "status": "CODE_CONTRACT",
    "created_at": "2026-08-31",
    "description": "Provider-neutral identity, provenance, metric and capability contract for MoxDOP Intelligence projections.",
    "formula_registry_id": "MOXDOP_FORMULA_REGISTRY",
    "evidence_pipeline": "CanonicalEvidencePipeline",
    "finding_rule_registry": "MOXDOP_FINDING_RULES"
  },
  "global_policies": {
    "PROVIDER_FACT_TABLES_REMAIN_CANONICAL": true,
    "NO_GENERIC_METRIC_WAREHOUSE": true,
    "MISSING_NEVER_EQUALS_ZERO": true,
    "ESTIMATED_NEVER_EQUALS_MEASURED": true,
    "PLATFORM_SIGNAL_NEVER_EQUALS_VERIFIED_OUTCOME": true,
    "RAW_SOURCE_IDENTITY_IS_PRESERVED": true,
    "URL_EQUIVALENCE_REQUIRES_EVIDENCE": true,
    "SEARCH_TERM_SEMANTICS_ARE_NOT_COLLAPSED": true,
    "PROJECTIONS_ARE_REBUILDABLE": true,
    "NO_MAGIC_SCORES": true,
    "AI_DOES_NOT_CREATE_FINDINGS": true,
    "EXTERNAL_WRITES_FORBIDDEN": true
  },
  "profiles": [
    {
      "id": "page",
      "label": "page profile",
      "status": "PROJECTION_NOT_IMPLEMENTED"
    },
    {
      "id": "search_term",
      "label": "search term profile",
      "status": "PROJECTION_NOT_IMPLEMENTED"
    },
    {
      "id": "entity",
      "label": "entity profile",
      "status": "PROJECTION_NOT_IMPLEMENTED"
    },
    {
      "id": "outcome",
      "label": "outcome profile",
      "status": "PROJECTION_NOT_IMPLEMENTED"
    }
  ],
  "dimensions": [
    {
      "id": "page",
      "identity_table": "intelligence_page_identities",
      "alias_table": "intelligence_page_aliases",
      "merge_policy": "Explicit redirect, declared canonical, CMS permalink, provider stable identity, rule or operator confirmation; syntactic normalization never merges www, scheme or trailing-slash variants."
    },
    {
      "id": "search_term",
      "identity_table": "intelligence_search_term_identities",
      "alias_table": "intelligence_search_term_aliases",
      "merge_policy": "Canonical text preserves diacritics. Folded text is clustering-only and source semantics remain distinct."
    },
    {
      "id": "entity",
      "identity_table": "intelligence_entity_identities",
      "alias_table": "intelligence_entity_aliases",
      "merge_policy": "Provider stable identity or explicit deterministic/operator match; no fuzzy auto-merge."
    },
    {
      "id": "business_action",
      "identity_table": "intelligence_business_action_identities",
      "alias_table": "intelligence_business_action_aliases",
      "merge_policy": "Provider signals map to a named Brand action without becoming verified business outcomes."
    },
    {
      "id": "time_context",
      "identity_table": null,
      "alias_table": null,
      "merge_policy": "Reporting date, timezone, observed/retrieved time, market, language, device, surface, model and sampling travel with every contribution."
    },
    {
      "id": "source_provenance",
      "identity_table": null,
      "alias_table": null,
      "merge_policy": "Provider, dataset, source record, asset/resource, collection run, dataset run and contract version are retained."
    }
  ],
  "source_classes": [
    {
      "id": "FIRST_PARTY_MEASURED",
      "meaning": "First-party measured provider fact."
    },
    {
      "id": "FIRST_PARTY_CONFIGURED",
      "meaning": "First-party configured state; not a measured outcome."
    },
    {
      "id": "DIRECT_OBSERVED",
      "meaning": "Direct public HTTP, HTML, DNS, TLS or browser observation."
    },
    {
      "id": "CMS_AUTHENTICATED",
      "meaning": "Authenticated CMS inside truth."
    },
    {
      "id": "PROVIDER_ATTRIBUTED",
      "meaning": "Provider-attributed platform result; not a verified business outcome."
    },
    {
      "id": "PROVIDER_ESTIMATED",
      "meaning": "Vendor estimate or modeled external intelligence; not first-party measurement."
    },
    {
      "id": "OPERATOR_MAINTAINED",
      "meaning": "Human-maintained MoxDOP fact."
    },
    {
      "id": "MOXDOP_DERIVED",
      "meaning": "Deterministic MoxDOP calculation with input provenance."
    },
    {
      "id": "AI_SEARCH_OBSERVED",
      "meaning": "Observed AI-search response with model, locale, time and sampling context; not universal visibility."
    }
  ],
