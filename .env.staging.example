# MoxDOP staging environment template
# Copy to the staging host as `.env` and fill placeholders.
# NEVER commit real secrets. NEVER reuse a committed/example APP_KEY.

# =============================================================================
# REQUIRED — application
# =============================================================================
APP_NAME=MoxDOP
APP_ENV=staging
APP_KEY=
# Generate ONCE on the staging host: php artisan key:generate --force
# Do not regenerate after encrypted provider credentials exist.
APP_DEBUG=false
APP_URL=https://staging.example.com
APP_FORCE_HTTPS=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Behind Nginx TLS termination. Use * only on a single-VPS private proxy hop.
TRUSTED_PROXIES=*

# =============================================================================
# REQUIRED — PostgreSQL (canonical staging DB)
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=moxdop_staging
DB_USERNAME=moxdop
DB_PASSWORD=
DB_SSLMODE=prefer

# =============================================================================
# REQUIRED — Redis (cache, queue, Horizon, locks)
# Sessions stay on the database so a Redis restart does not log operators out.
# =============================================================================
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=moxdop_staging_
HORIZON_PREFIX=moxdop_staging_horizon:
CACHE_PREFIX=moxdop_staging_

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# =============================================================================
# REQUIRED — collection / Horizon
# =============================================================================
COLLECTION_QUEUE_CONNECTION=redis
COLLECTION_QUEUE=collection
COLLECTION_REQUIRE_QUEUE=true
COLLECTION_DEFAULT_MAX_ATTEMPTS=3
COLLECTION_JOB_TIMEOUT=300

HORIZON_PATH=horizon
HORIZON_NAME=moxdop-staging
HORIZON_DEFAULT_TIMEOUT=300
HORIZON_COLLECTION_TIMEOUT=300
HORIZON_DEFAULT_MAX_PROCESSES=2
HORIZON_COLLECTION_MAX_PROCESSES=1
MOXDOP_OPS_EXPECTED_SUPERVISORS=supervisor-1,supervisor-collection

# =============================================================================
# REQUIRED — filesystem / logging / mail contract
# =============================================================================
FILESYSTEM_DISK=local
MOXDOP_RAW_INGESTION_DISK=raw_ingestion
MOXDOP_RAW_INGESTION_DRIVER=local
REPORT_PDF_DISK=local

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Staging may use log until SMTP is configured. Real SMTP smoke is a later phase.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log
# Reverb is OPTIONAL. Collection and operator UI poll. Do not fail deploy if absent.

# =============================================================================
# OPTIONAL — Google OAuth (do not fill until the Google provider phase)
# Callback: {APP_URL}/integrations/google/callback  (route: integrations.google.callback)
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_INCLUDE_GBP_SCOPE=false
GOOGLE_GBP_DISCOVERY_ENABLED=false

# =============================================================================
# OPTIONAL — Meta OAuth (do not fill until the Meta provider phase)
# Callback: {APP_URL}/integrations/meta/callback  (route: integrations.meta.callback)
# =============================================================================
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_LOGIN_CONFIGURATION_ID=
META_API_VERSION=v26.0

# =============================================================================
# OPTIONAL — DataForSEO (paid Sales Intent remains OFF)
# =============================================================================
DATAFORSEO_API_LOGIN=
DATAFORSEO_API_PASSWORD=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
MOXDOP_SALES_INTENT_PAID_CALLS=false
MOXDOP_INTENT_SEARCH_FIXTURES=false

# =============================================================================
# OPTIONAL — AI (application must boot without these)
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# =============================================================================
# OPTIONAL — encryption rotation
# =============================================================================
# APP_PREVIOUS_KEYS=

# =============================================================================
# DEFERRED
# =============================================================================
# Full SMTP UI, Reverb, mobile push, provider-health dashboard, live Public Discovery.
# S3 raw ingestion:
# MOXDOP_RAW_INGESTION_DRIVER=s3
# MOXDOP_RAW_INGESTION_KEY=
# MOXDOP_RAW_INGESTION_SECRET=
# MOXDOP_RAW_INGESTION_REGION=
# MOXDOP_RAW_INGESTION_BUCKET=
