{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moxdop.local/schemas/MOXDOP_DATA_POOL_STORAGE_V1.schema.json",
  "title": "MOXDOP_DATA_POOL_STORAGE_V1",
  "type": "object",
  "required": [
    "metadata",
    "enums",
    "dispositions",
    "physical_datasets",
    "control_tables",
    "validation"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "storage_contract_id",
        "version",
        "status",
        "data_contract_registry_id",
        "data_contract_registry_version",
        "production_database",
        "raw_storage"
      ],
      "properties": {
        "storage_contract_id": {
          "const": "MOXDOP_DATA_POOL_STORAGE"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string"
        },
        "data_contract_registry_id": {
          "type": "string"
        },
        "data_contract_registry_version": {
          "type": "integer"
        },
        "data_contract_registry_checksum": {
          "type": "string"
        },
        "data_contract_registry_commit": {
          "type": "string"
        },
        "formula_registry_version": {
          "type": "integer"
        },
        "collection_engine_reference": {
          "type": "string"
        },
        "production_database": {
          "const": "POSTGRESQL"
        },
        "raw_storage": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "enums": {
      "type": "object",
      "required": [
        "disposition",
        "write_mode",
        "partition_strategy"
      ],
      "properties": {
        "disposition": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_mode": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partition_strategy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "logical_dataset_id",
          "disposition"
        ],
        "properties": {
          "logical_dataset_id": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "table": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "physical_datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "logical_dataset_id",
          "table",
          "write_mode",
          "natural_key",
          "columns",
          "partition_strategy"
        ],
        "properties": {
          "logical_dataset_id": {
            "type": "string"
          },
          "table": {
            "type": "string"
          },
          "provider_or_source": {
            "type": "string"
          },
          "storage_class": {
            "type": "string"
          },
          "write_mode": {
            "type": "string"
          },
          "partition_strategy": {
            "type": "string"
          },
          "partition_column": {
            "type": [
              "string",
              "null"
            ]
          },
          "grain": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "natural_key": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "columns": {
            "type": "array",
            "minItems": 1
          },
          "indexes": {
            "type": "array"
          },
          "volume_class": {
            "type": "string"
          },
          "collection_run_in_natural_key": {
            "type": "boolean"
          }
        }
      }
    },
    "control_tables": {
      "type": "array"
    },
    "validation": {
      "type": "object"
    }
  }
}
