{
  "metadata": {
    "registry_id": "MOXDOP_FINDING_RULES",
    "version": 1,
    "status": "PRODUCTION_V1",
    "created_at": "2026-08-14",
    "description": "Versioned Finding Rule Registry. Rules consume canonical Evidence only. Thresholds are copied from frozen Website PerformanceFindingsCatalog — not invented folklore CTR/CPC/rank gates."
  },
  "invariants": {
    "NO_ARBITRARY_EXPRESSIONS": true,
    "NO_RUNTIME_EVAL": true,
    "NO_GENERIC_METRIC_PROMOTION": true,
    "EVIDENCE_NOT_FINDING": true,
    "NO_PROVIDER_TABLE_BYPASS": true,
    "MISSING_IS_NOT_CLEARED": true,
    "STALE_IS_NOT_CLEARED": true,
    "PARTIAL_IS_NOT_CLEARED": true,
    "NO_GOAL_OFFERING_NAME_INFERENCE": true,
    "NO_SERVICE_SCOPE_HIDDEN_SUPPRESSION": true,
    "FORMULAS_OWNED_BY_FORMULA_REGISTRY": true
  },
  "condition_types": [
    "VALUE_LT",
    "VALUE_LTE",
    "VALUE_GT",
    "VALUE_GTE",
    "VALUE_EQUALS",
    "VALUE_BETWEEN",
    "VALUE_OUTSIDE",
    "STATE_EQUALS",
    "STATE_NOT_EQUALS",
    "BOOLEAN_IS",
    "ABSENCE_CONFIRMED",
    "PRESENCE_CONFIRMED",
    "ABS_DECREASE_GTE",
    "ABS_INCREASE_GTE"
  ],
  "rules": [
    {
      "id": "website.gsc.clicks_relative_decline",
      "stable_id": "website:gsc:clicks-decline",
      "version": 1,
      "enabled": true,
      "meaning": "Search Console property clicks declined versus the previous comparable period under frozen catalog gates.",
      "category": "performance",
      "severity": "high",
      "severity_policy": "static",
      "source_module": "website",
      "consumer_intent": "operator_finding_queue",
      "evidence_definition_ids": ["gsc.property.period_comparison"],
      "required_evidence_kinds": ["period_comparison"],
      "scope_requirements": ["customer", "brand", "digital_asset"],
      "subject": {
        "kind": "digital_asset",
        "grain": "PER_DIGITAL_ASSET"
      },
      "goal_offering_policy": "inherit_explicit_evidence_scope_do_not_infer",
      "include_goal_in_fingerprint": false,
      "include_offering_in_fingerprint": false,
      "include_period_in_fingerprint": false,
      "cardinality": {
        "strategy": "PER_DIGITAL_ASSET",
        "max_per_digital_asset": 1,
        "bound": "one_finding_per_asset"
      },
      "join_key": ["customer_id", "brand_id", "digital_asset_id"],
      "integrity_requirement": "trusted",
      "freshness_requirement": "fresh_or_fresh_with_limitation",
      "completeness_requirement": "required_states_are_VALUE",
      "provider_limitation_policy": "block_not_false",
      "activation_policy": "IMMEDIATE",
      "threshold_source": "MoxDop\\Website\\Findings\\PerformanceFindingsCatalog",
      "units": {
        "count": "count",
        "relative_change": "ratio"
      },
      "currency_policy": "not_applicable",
      "period_compatibility": "same_evidence_period",
      "dimension_compatibility": "property_grain",
      "required_operand_states": [
        { "path": "metrics.clicks.relative_change_state", "equals": "VALUE" }
      ],
      "activation": {
        "combiner": "ALL",
        "conditions": [
          { "type": "VALUE_GTE", "path": "metrics.clicks.previous", "value": 100, "unit": "count" },
          { "type": "VALUE_LTE", "path": "metrics.clicks.relative_change", "value": -0.2, "unit": "ratio" },
          { "type": "ABS_DECREASE_GTE", "current_path": "metrics.clicks.current", "previous_path": "metrics.clicks.previous", "value": 20, "unit": "count" }
        ]
      },
      "clear": {
        "combiner": "ALL",
        "conditions": [
          { "type": "VALUE_GTE", "path": "metrics.clicks.previous", "value": 100, "unit": "count" },
          { "type": "VALUE_GT", "path": "metrics.clicks.relative_change", "value": -0.2, "unit": "ratio" }
        ]
      },
      "auto_resolve": true,
      "reopen_policy": "REOPEN_SAME_FINDING",
      "fingerprint_inputs": ["stable_rule_id", "customer_id", "brand_id", "digital_asset_id", "subject_kind", "subject_id"],
      "evaluation_fingerprint_inputs": ["finding_fingerprint", "rule_version", "evidence_observation_fingerprints", "period", "condition_config"],
      "title_template": "Search Console clicks declined",
      "summary_template": "Clicks moved from {metrics.clicks.previous} to {metrics.clicks.current} (relative change {metrics.clicks.relative_change}) versus the previous comparable period."
    },
