      "evaluation_fingerprint_inputs": ["finding_fingerprint", "rule_version", "evidence_observation_fingerprints", "period", "condition_config"],
      "title_template": "Search Console CTR declined",
      "summary_template": "CTR moved from {metrics.ctr.previous} to {metrics.ctr.current} versus the previous comparable period with prior impressions {metrics.impressions.previous}."
    },
