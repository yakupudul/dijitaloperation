; Supervisor program for MoxDOP staging Horizon.
; Copy to /etc/supervisor/conf.d/moxdop-staging-horizon.conf and adjust user/paths.
;
; Deployments must use `php artisan horizon:terminate` and let Supervisor restart this program.
; Do not kill -9 workers.
;
; sudo supervisorctl reread && sudo supervisorctl update
; sudo supervisorctl status moxdop-staging-horizon:*

[program:moxdop-staging-horizon]
process_name=%(program_name)s
command=php /var/www/moxdop-staging/artisan horizon
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/log/moxdop-staging-horizon.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
stopwaitsecs=3600
