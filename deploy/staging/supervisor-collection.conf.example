; Dedicated canonical collection worker for MoxDOP staging.
; PostgreSQL collection state is the source of truth. This worker executes
; queued/retrying datasets directly, so Redis/Horizon transport issues cannot
; strand runs in "queued" forever. Dataset dispatch locks prevent duplicates.

[program:moxdop-staging-collection]
process_name=%(program_name)s
command=php /var/www/moxdop/artisan moxdop:collection:work-db --sleep=1 --max-runtime=3500
directory=/var/www/moxdop
autostart=true
autorestart=true
startsecs=2
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/log/moxdop-staging-collection.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
stopwaitsecs=360
